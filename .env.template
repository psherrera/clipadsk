# Configuración de Clipadsk. Copiar como .env y completar lo que haga falta.
# Todo es opcional.

# API key de Groq (transcripción rápida + herramientas de IA). Gratis en https://console.groq.com/keys
# También se puede cargar desde la app (Config → API Key), que se guarda solo en tu navegador.
GROQ_API_KEY=

# ── Red y seguridad ───────────────────────────────────────────────────────────
# Por defecto Clipadsk solo es accesible desde esta PC (127.0.0.1).
# Para usarlo desde otras PCs de la red: HOST=0.0.0.0 y definí ADMIN_TOKEN.
HOST=127.0.0.1
PORT=5000
# Si se define, los botones de mantenimiento (actualizar/resetear) exigen este token
# en el header X-ADMIN-TOKEN.
ADMIN_TOKEN=
# Orígenes web permitidos, separados por coma (por defecto: localhost/127.0.0.1)
# FRONTEND_ALLOWED_ORIGINS=http://192.168.0.10:5000

# ── Transcripción ─────────────────────────────────────────────────────────────
# Modelo de Whisper local (solo si instalaste faster-whisper): tiny, base, small, medium
WHISPER_MODEL=small
# Modelos de Groq: listas en orden de preferencia, separadas por coma. La app usa el
# primero que tu cuenta tenga disponible (Groq retira modelos cada tanto).
# GROQ_TEXT_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
# GROQ_CHAT_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant,openai/gpt-oss-120b
# GROQ_VISION_MODELS=qwen/qwen3.8-27b
# GROQ_WHISPER_MODELS=whisper-large-v3,whisper-large-v3-turbo
# Textos más largos que esto se muestran sin limpieza de puntuación con IA (cuida el cupo de Groq)
# AI_CLEANUP_MAX_CHARS=120000
# Tamaño máximo de archivo subido para transcribir (MB)
# MAX_UPLOAD_MB=500

# ── Otros ─────────────────────────────────────────────────────────────────────
FRONTEND_DIR=../frontend
LOG_LEVEL=INFO
